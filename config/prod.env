# Configuração da infraestrutura de produção (Magalu Cloud). SEM SEGREDOS: este arquivo é versionado.
# Senhas, chaves e kubeconfig ficam em secrets/ (fora do git), gerados pelos próprios scripts.

# Região (br-se1 = Sudeste). Todos os recursos ficam nela.
MGC_REGION=br-se1
# Versão mínima do CLI (o v0.48 não tem todos os comandos usados aqui).
MGC_MIN_VERSION=0.67.0

# Container Registry: nome global, só minúsculas e números.
REGISTRY_NAME=msmthelpdesk

# Object Storage (spec T13 e backups, etapa 9 de helpdesk/docs/ambientes.md)
BUCKET_ATTACHMENTS=helpdesk-anexos
BUCKET_BACKUPS=helpdesk-backups
OBJECT_STORAGE_KEY_NAME=helpdesk-app

# Kubernetes gerenciado (ADR-007: 2 nós)
K8S_CLUSTER_NAME=msmt-prod
# Conferido em 2026-10-24 (`mgc kubernetes version list`): suportadas v1.33.6, v1.34.2, v1.35.2.
# A penúltima, por estabilidade. kubectl local precisa estar a no máximo 1 versão menor de distância.
K8S_VERSION=v1.34.2
K8S_NODEPOOL_NAME=default
# Tipo de máquina dos nós (v0.67: tipos de VM; o menor aceito é BV2-4-40 = 2 vCPU, 4 GB, 40 GB).
# Opções: mgc virtual-machine machine-types list
K8S_NODE_FLAVOR=BV2-4-40
K8S_NODE_COUNT=2
# Quem pode falar com a API do cluster (CIDR). Vazio = sem restrição; ⚠️ restrinja ao IP fixo do escritório, se houver.
K8S_ALLOWED_CIDRS=

# DBaaS PostgreSQL (bancos `zitadel` e `helpdesk` na mesma instância)
DB_INSTANCE_NAME=msmt-postgres
DB_ENGINE_NAME=postgresql
# Mesma versão do docker-compose local (postgres:17). Opções: mgc dbaas engines list --status ACTIVE
DB_ENGINE_VERSION=17
# Instância criada pelo painel em 2026-10-24 (PostgreSQL 17, BV1-4-10, br-se1-a). O script só cria se não existir.
DB_INSTANCE_TYPE=BV1-4-10
DB_VOLUME_SIZE_GB=20
DB_AVAILABILITY_ZONE=br-se1-a
DB_ADMIN_USER=msmtadmin
DB_BACKUP_RETENTION_DAYS=7
# Horário UTC do backup automático do DBaaS (01:00 em Cuiabá = 05:00 UTC).
DB_BACKUP_START_AT=05:00:00

# Add-ons do cluster (ADR-007). Versões fixadas: confira as atuais com `helm search repo ... --versions`.
TRAEFIK_CHART_VERSION=42.1.3
CERT_MANAGER_VERSION=v1.21.3
# E-mail para o Let's Encrypt (avisos de expiração).
ACME_EMAIL=dti@missaosalesiana.org.br
